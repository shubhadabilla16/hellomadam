# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Business Official Contacts (used for server-side owner alerts)
BUSINESS_WHATSAPP="919657156795"
BUSINESS_EMAIL="dfinesolapur@gmail.com"

# WhatsApp Business Cloud API (Optional - Meta Graph API)
# Leave unset if not connected; notification logs will honestly record 'not_configured'
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Transactional Email SMTP (Optional - Nodemailer)
# Leave unset if not connected; notification logs will honestly record 'not_configured'
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hello Madam Solapur <dfinesolapur@gmail.com>"
